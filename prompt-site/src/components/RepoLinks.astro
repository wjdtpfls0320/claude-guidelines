---
// 저장소 문서(README)를 사이트에 가져올 때, 저장소 안 파일을 가리키는 상대 링크를 정리합니다.
// 지침.txt 링크는 지침 페이지로 보내고, 사이트에 없는 파일 링크는 링크를 풀어 글자만 남깁니다.
// 여기 들어오는 HTML은 방문자 입력이 아니라 저장소의 README를 빌드할 때 변환한 것입니다.
const html = await Astro.slots.render('default');
const cleaned = html.replace(/<a href="(\.\/[^"]*)"[^>]*>([\s\S]*?)<\/a>/g, (_match, href: string, inner: string) => {
  let target = href;
  try {
    target = decodeURIComponent(href);
  } catch {
    // 주소를 풀 수 없으면 그대로 비교합니다.
  }
  return target.includes('지침.txt') ? `<a href="/guideline/">${inner}</a>` : inner;
});
---

<Fragment set:html={cleaned} />
