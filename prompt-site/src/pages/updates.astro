---
import Base from '../layouts/Base.astro';
import { itemAnchor, itemLabel } from '../lib/guideline-parser';
import { loadGuideline, loadPublicPrompts, loadUpdates } from '../lib/prompt-loader';

const guideline = loadGuideline();
const labels = new Map(guideline.items.map((item) => [item.key, itemLabel(item)]));
const titles = new Map(loadPublicPrompts(guideline).map((prompt) => [prompt.id, prompt.title]));
const updates = loadUpdates();
---

<Base title="업데이트 기록" description="지침이 언제 어떻게 바뀌었고, 그에 따라 어떤 프롬프트를 다시 검토했는지">
  <div class="page-head">
    <h1>업데이트 기록</h1>
    <p>
      지침이 바뀌면 그 항목에 기대는 프롬프트를 목록에서 내리고, 다시 검토한 뒤에 올립니다. 여기에는 바뀐 지침 항목과 다시
      검토한 프롬프트를 날짜순으로 남깁니다.
    </p>
  </div>

  <ul class="update-list">
    {
      updates.map((entry) => (
        <li>
          <time datetime={entry.날짜}>{entry.날짜}</time>
          <div class="body">
            <ul class="badges" aria-label="바뀐 지침 항목">
              {entry.지침항목.map((key) => (
                <li>
                  <a class="badge" href={`/guideline/#${itemAnchor(key)}`}>
                    {labels.get(key) ?? key}
                  </a>
                </li>
              ))}
            </ul>
            <p>{entry.요약}</p>
            {entry.검토한프롬프트.length > 0 ? (
              <details>
                <summary>이 지침 기준으로 검토한 프롬프트 {entry.검토한프롬프트.length}개</summary>
                <ul class="inline-links mt">
                  {entry.검토한프롬프트.map((id) => (
                    <li>{titles.has(id) ? <a href={`/prompt/${id}/`}>{titles.get(id)}</a> : <span>{id} (검토 중)</span>}</li>
                  ))}
                </ul>
              </details>
            ) : (
              <p class="note">사이트를 만들기 전의 지침 변경이라 검토한 프롬프트가 없습니다.</p>
            )}
          </div>
        </li>
      ))
    }
  </ul>
</Base>
