---
import Base from '../layouts/Base.astro';
import DraftNotice from '../components/DraftNotice.astro';
import { site } from '../data/site';
---

<Base title="사업자 정보 (초안)">
  <article class="prose">
    <h1>사업자 정보 (초안)</h1>
    <DraftNotice />
    <p>
      지금은 무료 서비스라 아래 표시가 의무인지 확인이 필요합니다. <strong>[전문가 확인]</strong> 유료 서비스를 시작하면
      모든 칸을 채워야 하고, 통신판매업 신고가 필요한지는 수익 모델에 따라 달라집니다.
    </p>
    <table>
      <tbody>
        <tr><th scope="row">상호</th><td><span class="placeholder">[채울 자리: 상호]</span></td></tr>
        <tr><th scope="row">대표자</th><td><span class="placeholder">[채울 자리: 대표자]</span></td></tr>
        <tr><th scope="row">주소</th><td><span class="placeholder">[채울 자리: 주소]</span></td></tr>
        <tr><th scope="row">연락처</th><td><span class="placeholder">{site.contactEmail}</span></td></tr>
        <tr><th scope="row">사업자등록번호</th><td><span class="placeholder">[채울 자리: 사업자등록번호]</span></td></tr>
        <tr>
          <th scope="row">통신판매업 신고번호</th>
          <td><span class="placeholder">[채울 자리: 해당되면 신고번호]</span></td>
        </tr>
        <tr><th scope="row">호스팅 제공자</th><td>Cloudflare, Inc. (Cloudflare Pages, 배포 예정)</td></tr>
      </tbody>
    </table>
  </article>
</Base>
