---
import Base from '../../layouts/Base.astro';
import ItemBadges from '../../components/ItemBadges.astro';
import { fields } from '../../data/fields';
import { splitTemplate } from '../../lib/fill-blanks';
import { guidelineVersion, loadGuideline, loadPublicPrompts, type LoadedPrompt } from '../../lib/prompt-loader';

export function getStaticPaths() {
  return loadPublicPrompts().map((prompt) => ({ params: { id: prompt.id }, props: { prompt } }));
}

interface Props {
  prompt: LoadedPrompt;
}

const { prompt } = Astro.props;
const guideline = loadGuideline();
const version = guidelineVersion();
const field = fields.find((candidate) => candidate.name === prompt.field)!;
const segments = splitTemplate(prompt.template);
// 프롬프트에서 한 줄을 통째로 차지하는 빈칸은 여러 줄을 붙여 넣는 칸으로 봅니다.
const lines = prompt.template.split('\n').map((line) => line.trim());
const isLong = (name: string) => lines.includes(`{${name}}`);
---

<Base title={prompt.title} description={prompt.description} currentField={field.slug}>
  <div data-pagefind-body>
    <p class="crumbs">
      <a href={`/field/${field.slug}/`} data-pagefind-meta="field">{prompt.field}</a> ›
      <span data-pagefind-meta="situation">{prompt.situation}</span>
    </p>
    <div class="page-head">
      <h1>{prompt.title}</h1>
      <p data-pagefind-meta="description">{prompt.description}</p>
    </div>

    <div class="workbench" data-prompt>
      <section class="panel" aria-labelledby="blanks-heading" data-pagefind-ignore>
        <h2 id="blanks-heading">빈칸 채우기</h2>
        <form class="blanks" data-blanks autocomplete="off">
          {
            prompt.blanks.map((blank, index) => (
              <div>
                <label for={`blank-${index}`}>{blank.name}</label>
                {blank.hint && (
                  <span class="hint" id={`blank-${index}-hint`}>
                    {blank.hint}
                  </span>
                )}
                {isLong(blank.name) ? (
                  <textarea
                    class="textarea"
                    id={`blank-${index}`}
                    data-blank={blank.name}
                    aria-describedby={blank.hint ? `blank-${index}-hint` : undefined}
                  />
                ) : (
                  <input
                    class="input"
                    type="text"
                    id={`blank-${index}`}
                    data-blank={blank.name}
                    aria-describedby={blank.hint ? `blank-${index}-hint` : undefined}
                  />
                )}
              </div>
            ))
          }
          <p class="note">입력한 내용은 이 브라우저 안에서만 쓰이고, 서버로 보내거나 저장하지 않습니다.</p>
        </form>
      </section>

      <section class="panel result" aria-labelledby="result-heading">
        <h2 id="result-heading">완성된 프롬프트</h2>
        <pre class="prompt-preview" tabindex="0" data-preview data-template={prompt.template}>{segments.map((segment) =>
          segment.type === 'text' ? segment.value : <mark>{`{${segment.name}}`}</mark>,
        )}</pre>
        <div class="copy-row" data-pagefind-ignore>
          <button class="button primary large" type="button" data-copy>프롬프트 복사</button>
          <p class="copy-status" role="status" aria-live="polite" data-status></p>
        </div>
      </section>
    </div>

    <div class="detail-meta">
      <span>기대는 지침</span>
      <ItemBadges keys={prompt.items} items={guideline.items} />
      <span>· 지침 v{version} 기준 · {prompt.reviewed} 검토</span>
    </div>
    <ul class="badges mt" aria-label="태그">
      {
        prompt.tags.map((tag) => (
          <li>
            <a class="badge" href={`/search/?q=${encodeURIComponent(tag)}`}>
              #{tag}
            </a>
          </li>
        ))
      }
    </ul>

    <section class="section">
      <h2>왜 이렇게 썼나</h2>
      <ul>
        {prompt.why.map((line) => <li>{line}</li>)}
      </ul>
    </section>

    <div class="two-col">
      <section class="section">
        <h2>기대 응답</h2>
        <ul class="check-list good">
          {prompt.expected.map((line) => <li>{line}</li>)}
        </ul>
      </section>
      <section class="section">
        <h2>실패 신호</h2>
        <ul class="check-list bad">
          {prompt.failure.map((line) => <li>{line}</li>)}
        </ul>
      </section>
    </div>
    <p class="note mt" data-pagefind-ignore>
      실패 신호가 보이면 AI 개인 설정에 <a href="/guideline/">지침</a>이 들어 있는지, 새 대화에서 시작했는지 확인하세요. 이
      프롬프트는 아직 새 대화 테스트 기록이 없습니다.
    </p>

    {
      prompt.followups.length > 0 && (
        <section class="section">
          <h2>이어서 쓰는 문장</h2>
          <ul class="followups">
            {prompt.followups.map((line) => (
              <li>
                <span data-followup-text>{line}</span>
                <button class="button" type="button" data-followup-copy data-pagefind-ignore>
                  복사
                </button>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</Base>

<script>
  import '../../scripts/prompt-detail.ts';
</script>
