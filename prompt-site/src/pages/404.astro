---
import Base from '../layouts/Base.astro';
import { fields } from '../data/fields';
---

<Base title="없는 주소" noindex>
  <div class="page-head">
    <h1>없는 주소예요</h1>
    <p>
      주소가 바뀌었거나, 지침이 바뀌어 다시 검토하는 동안 내려둔 프롬프트일 수 있어요.
    </p>
  </div>
  <p><a class="button primary" href="/">홈으로</a> <a class="button" href="/search/">검색하기</a></p>
  <section class="section">
    <h2>분야에서 고르기</h2>
    <ul class="inline-links">
      {
        fields.map((field) => (
          <li>
            <a href={`/field/${field.slug}/`}>{field.name}</a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
